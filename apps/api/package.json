{
  "name": "@kaenal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx src/jobs/worker.ts",
    "worker:watch": "tsx watch src/jobs/worker.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:testdata": "tsx scripts/seed-testdata.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/client-sesv2": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@kaenal/core": "workspace:*",
    "@kaenal/db": "workspace:*",
    "@kaenal/types": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@sentry/node": "^10.70.0",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "argon2": "^0.41.1",
    "bullmq": "^5",
    "fflate": "^0.8.2",
    "ioredis": "^5.4.2",
    "otpauth": "^9.3.6",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "yjs": "^13.6.32",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@kaenal/config": "workspace:*",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
