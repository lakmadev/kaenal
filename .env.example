# ---------------------------------------------------------------------------
# Kaenal — local environment template. Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real credentials.
# Every var here is validated at boot by the app's Zod EnvSchema (01 §2) —
# a missing or malformed value crashes at startup, never at request time.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Owner role. Runs migrations only. Used by db:migrate / provisioning.
DATABASE_URL=postgres://kaenal_migrator:kaenal_local_pw@localhost:5433/kaenal
# The API's role: NOT table owner, NOT BYPASSRLS. All tenant queries use this.
DATABASE_APP_URL=postgres://kaenal_app:kaenal_local_pw@localhost:5433/kaenal
# Public/unauthenticated routes. No access to tenant tables.
DATABASE_PUBLIC_URL=postgres://kaenal_public:kaenal_local_pw@localhost:5433/kaenal

# --- Model B: dedicated Postgres per tenant (01 §3.1) --------------------
# Enterprise tenants get their own database. control.tenants.database_url_secret_ref
# points at the app-role connection string (never the credential itself):
#   localdb:<dbname>  — same cluster as the primary; the URL is derived from
#                       DATABASE_APP_URL by swapping the database name. This is what
#                       `provision-tenant --model dedicated` writes; no env var needed.
#   env:VAR_NAME      — dedicated DB on another host; set the URL in that variable:
#                       TENANT_BOSCH_DB_URL=postgres://kaenal_app:...@bosch-db:5432/kaenal
# LRU cap on how many dedicated pools the API holds at once (default 20). Optional.
# TENANT_MAX_DEDICATED_POOLS=20

# --- Redis (sessions, rate limits, idempotency keys, BullMQ) --------------
REDIS_URL=redis://localhost:6380

# --- Object storage (MinIO locally, S3/R2 in cloud) ----------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kaenal-local
S3_KEY=kaenal
S3_SECRET=kaenal_local_pw
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Presigned upload/download URL TTL in seconds (03 §7/§8 specify 15 min). Optional.
# S3_URL_TTL_SECONDS=900

# --- Auth -----------------------------------------------------------------
# Session cookie / JWT signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-of-base64-randomness

# --- App ------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# Rate limiting (03 §9). Unset follows NODE_ENV: on everywhere except `test`.
# Set explicitly to override (e.g. false to disable locally while debugging).
# RATE_LIMIT_ENABLED=true

# Background jobs (06). Unset follows NODE_ENV (on except `test`). The API only
# ENQUEUES; run the consumer separately: pnpm --filter @kaenal/api worker
# JOBS_ENABLED=true

# --- Email delivery (providers/email) -------------------------------------
# Provider behind the EmailPort. `console` (default) logs instead of sending, so
# dev/test/provider-less deploys still run every email flow. `ses` uses AWS SES.
# Switching providers is one new adapter + this var — no business-code changes.
EMAIL_PROVIDER=console
# Verified From address (required for real sending).
MAIL_FROM=Kaenal <no-reply@kaenal.local>
# SES only. Region falls back to S3_REGION when unset (single-region AWS).
# AWS_REGION=eu-west-1
# SES configuration set for bounce/complaint publishing (recommended in prod).
# SES_CONFIGURATION_SET=kaenal-default
# Leave BOTH unset in production — the task/pod IAM role supplies credentials.
# Only for environments without a role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Antivirus (providers/av) ---------------------------------------------
# `stub` (default) verdicts by filename and inspects zero bytes — dev/test/CI
# only. `clamav` streams each upload to a clamd daemon (never run prod on stub).
# `docker compose up -d clamav` starts a local daemon on :3310.
AV_PROVIDER=stub
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=120000

# --- Phase 4 (leave blank until then) ------------------------------------
# Enterprise SSO (SAML/OIDC) + SCIM provisioning.
WORKOS_API_KEY=
# AI gateway key for 8D copilot / root-cause suggestions / summaries.
AI_GATEWAY_KEY=
