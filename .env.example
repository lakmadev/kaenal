# ---------------------------------------------------------------------------
# Kaenal — local environment template. Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real credentials.
# Every var here is validated at boot by the app's Zod EnvSchema (01 §2) —
# a missing or malformed value crashes at startup, never at request time.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Owner role. Runs migrations only. Used by db:migrate / provisioning.
DATABASE_URL=postgres://kaenal_migrator:kaenal_local_pw@localhost:5433/kaenal
# The API's role: NOT table owner, NOT BYPASSRLS. All tenant queries use this.
DATABASE_APP_URL=postgres://kaenal_app:kaenal_local_pw@localhost:5433/kaenal
# Public/unauthenticated routes. No access to tenant tables.
DATABASE_PUBLIC_URL=postgres://kaenal_public:kaenal_local_pw@localhost:5433/kaenal

# --- Redis (sessions, rate limits, idempotency keys, BullMQ) --------------
REDIS_URL=redis://localhost:6380

# --- Object storage (MinIO locally, S3/R2 in cloud) ----------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kaenal-local
S3_KEY=kaenal
S3_SECRET=kaenal_local_pw
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# --- Auth -----------------------------------------------------------------
# Session cookie / JWT signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-bytes-of-base64-randomness

# --- App ------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# Rate limiting (03 §9). Unset follows NODE_ENV: on everywhere except `test`.
# Set explicitly to override (e.g. false to disable locally while debugging).
# RATE_LIMIT_ENABLED=true

# --- Phase 4 (leave blank until then) ------------------------------------
# Enterprise SSO (SAML/OIDC) + SCIM provisioning.
WORKOS_API_KEY=
# AI gateway key for 8D copilot / root-cause suggestions / summaries.
AI_GATEWAY_KEY=
