{
  "name": "kaenal",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:mobile": "pnpm --filter @kaenal/mobile lint",
    "test": "turbo run test --concurrency=1",
    "test:rls": "pnpm --filter @kaenal/db test:rls",
    "db:generate": "pnpm --filter @kaenal/db generate",
    "db:migrate": "pnpm --filter @kaenal/db migrate",
    "db:migrate:tenants": "pnpm --filter @kaenal/db migrate-tenants",
    "db:check": "pnpm --filter @kaenal/db check-rls",
    "db:reset": "pnpm --filter @kaenal/db reset",
    "provision-tenant": "pnpm --filter @kaenal/db provision-tenant",
    "offboard-tenant": "pnpm --filter @kaenal/db offboard-tenant",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^15",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-react": "^7.37",
    "eslint-plugin-react-hooks": "^5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
