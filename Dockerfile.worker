# syntax=docker/dockerfile:1.7
# ==============================================================================
# Kaenal jobs worker (BullMQ). Build context = repo root:
#     docker build -f Dockerfile.worker -t kaenal-worker .
#
# Intentionally near-identical to Dockerfile.api — same image, different process
# (SLA escalation, AV scan, notification delivery, exports, scheduling, expiry
# reminders, purge, audit-partition roll). It is a BACKGROUND worker: no HTTP
# port. Run it as a separate service/process from the API so they scale apart.
#
# Same rationale as the API image: tsx-from-source runtime, glibc base for the
# native argon2 dep, tini for clean SIGTERM (BullMQ drains in-flight jobs on the
# worker's own SIGTERM handler — see apps/api/src/jobs/worker.ts).
# ==============================================================================

FROM node:22-bookworm-slim AS base
# NODE_ENV is NOT production here — see Dockerfile.api (tsx is a devDep).
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/api-client/package.json packages/api-client/
COPY packages/config/package.json packages/config/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/types/package.json packages/types/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "@kaenal/api..."

FROM base AS runtime
ENV NODE_ENV=production \
    JOBS_ENABLED=true
RUN apt-get update && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/*
COPY --from=deps --chown=node:node /app/ ./
COPY --chown=node:node . .
USER node
WORKDIR /app/apps/api
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node_modules/.bin/tsx", "src/jobs/worker.ts"]
